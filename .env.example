PORT=8081
APP_ENV=local
FRONTEND_ORIGIN=http://localhost:5173
AVATAR_DIR=data/avatars
ATTACHMENT_DIR=data/attachments
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_DATABASE=blueprint
BLUEPRINT_DB_USERNAME=melkey
BLUEPRINT_DB_PASSWORD=password1234
BLUEPRINT_DB_SCHEMA=public
# Calls (LiveKit). The secret must have at least 32 characters; generate one with: openssl rand -hex 32
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=golive
LIVEKIT_API_SECRET=change-me-to-a-random-secret-of-32-chars
# IP browsers use to reach LiveKit media. Use this machine's LAN IP (e.g. from `ip route get 1.1.1.1`),
# not 127.0.0.1: Firefox ignores loopback addresses in WebRTC, so calls would hang on "Conectando…".
LIVEKIT_NODE_IP=192.168.0.10
